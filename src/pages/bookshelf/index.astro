---
import FormattedDate from '@/components/FormattedDate.astro';
import Page from '@/layouts/Page.astro';
import { slashPagesMap } from '@/slashPages';
import { orderBy } from '@/utils';
import { Image } from 'astro:assets';
import books from './_data.json';
---

<Page title={slashPagesMap['Bookshelf'].name}>
	{
		[
			{
				status: 'Reading',
				books: orderBy(
					books.filter((book) => book.status == 'reading'),
					['start', 'desc'],
					['author'],
					['title']
				),
			},
			{
				status: 'Read',
				books: [
					...orderBy(
						books.filter((book) => book.status == 'read' && book.end),
						['end', 'desc'],
						['author'],
						['title']
					),
					...orderBy(
						books.filter((book) => book.status == 'read' && !book.end),
						['author'],
						['title']
					),
				],
			},
			{
				status: 'Abandoned',
				books: orderBy(
					books.filter((book) => book.status == 'abandoned'),
					['end', 'desc'],
					['author'],
					['title']
				),
			},
		]
			.filter((el) => el.books.length > 0)
			.map((el) => (
				<>
					<h2>
						{el.status} ({el.books.length})
					</h2>
					<ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6 not-prose">
						{el.books.map((book) => (
							<li class="card card-sm shadow-sm">
								{book.image ? (
									<figure>
										{/* images hotlinked from https://www.goodreads.com/ */}
										<Image
											src={book.image}
											alt={`Cover of ${book.title} - ${book.author}`}
											width={166}
											height={270}
											loading={'lazy'}
											class="w-full"
										/>
									</figure>
								) : null}
								<div class="card-body">
									<div class="space-x-2">
										{book.current_page != '' && book.total_pages != '' ? (
											<span>{`${book.current_page} of ${book.total_pages} pages`}</span>
										) : (
											<span class="hidden" data-progress-title={book.title} />
										)}
									</div>
									<span class="card-title">{book.title}</span>
									{book.subtitle ? <p class="grow-0">{book.subtitle}</p> : null}
									<p class="text-sm font-medium">{book.author}</p>

									<div class="mt-4 pt-3 border-t border-base-200 flex flex-col gap-1">
										<p class="text-xs text-base-content/70">
											<span class="font-semibold">Start:</span>{' '}
											{book.start != '' ? <FormattedDate date={new Date(book.start)} /> : 'N/A'}
										</p>
										<p class="text-xs text-base-content/70">
											<span class="font-semibold">End:</span>{' '}
											{book.end != '' ? <FormattedDate date={new Date(book.end)} /> : 'N/A'}
										</p>
									</div>
								</div>
							</li>
						))}
					</ul>
				</>
			))
	}

	<script>
		async function fetchProgress() {
			const sheetUrl =
				'https://docs.google.com/spreadsheets/d/1nVMcwhfriKQnWcikfY35FdEkG-fjhLay5K9rg7S4LzY/export?format=tsv';
			try {
				const response = await fetch(sheetUrl);
				const tsvText = await response.text();

				const progressMap = new Map();
				tsvText
					.split('\n')
					.slice(1)
					.forEach((row) => {
						row = row.trim();
						if (!row) return;
						const parts = row.split('\t').map((ele) => ele.trim());
						let [title, current, total] = parts;
						if (total !== '' && current !== '') {
							progressMap.set(title, { current, total });
						}
					});

				document.querySelectorAll('[data-progress-title]').forEach((el) => {
					const title = el.getAttribute('data-progress-title');
					if (title && progressMap.has(title)) {
						const { current, total } = progressMap.get(title);
						el.textContent = `${current} of ${total} pages`;
						el.classList.remove('hidden');
					}
				});
			} catch (error) {
				console.error('Failed to load reading progress', error);
			}
		}

		fetchProgress();
	</script>
</Page>
