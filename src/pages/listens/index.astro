---
import Link from '@/components/Link.astro';
import { FIRST_NAME } from '@/consts';
import Page from '@/layouts/Page.astro';
import { clsx } from '@/utils';
import { Image } from 'astro:assets';
import songs from './_data.json';

const languageCounts = songs.reduce(
	(counts, song) => {
		for (const language of song.languages) {
			counts[language] = (counts[language] ?? 0) + 1;
		}
		return counts;
	},
	{} as { [key: string]: number }
);

const languages = Object.entries(languageCounts)
	.sort((a, b) => b[1] - a[1])
	.map(([language]) => language);

languages.unshift('All');
---

<Page title={`${FIRST_NAME} Listens To Music`}>
	<p>
		<strong id="listens-song-count">{songs.length}</strong>
		<span id="listens-song-label">{songs.length === 1 ? 'song' : 'songs'}</span>
	</p>

	<noscript>
		<style>
			#listens-language-fieldset {
				display: none;
			}
		</style>
	</noscript>

	<fieldset class="fieldset mb-6" id="listens-language-fieldset">
		<legend class="fieldset-legend">Language</legend>
		<select class="select" id="listens-language-filter">
			{
				languages.map((language) => (
					<option value={language} selected={language === 'All'}>
						{language}
					</option>
				))
			}
		</select>
	</fieldset>

	<ul class="grid min-[30rem]:grid-cols-2 sm:grid-cols-3 gap-4 md:gap-6 not-prose">
		{
			songs
				.sort((a, b) => a.title.localeCompare(b.title) || a.artist.localeCompare(b.artist))
				.map((song, index) => (
					<li
						class="max-w-[240px] w-full mx-auto sm:max-w-none"
						data-listens-languages={JSON.stringify(song.languages)}
					>
						<Link class="card card-sm shadow-sm h-full" href={song.url}>
							{song.image ? (
								<figure class="aspect-square">
									<Image
										src={song.image}
										alt={`Thumbnail for ${song.title} - ${song.artist}`}
										width={240}
										height={240}
										loading={index < 9 ? 'eager' : 'lazy'}
										class={clsx(
											'w-full h-full object-cover scale-[1.33]',
											song.explicit_image === 'TRUE' ? 'blur-sm' : ''
										)}
									/>
								</figure>
							) : null}
							<div class="card-body justify-between">
								<span class="card-title line-clamp-2">{song.title}</span>
								<p class="grow-0">{song.artist}</p>
							</div>
						</Link>
					</li>
				))
		}
	</ul>

	<script>
		const filter = document.getElementById('listens-language-filter');
		const count = document.getElementById('listens-song-count');
		const label = document.getElementById('listens-song-label');

		filter?.addEventListener('change', (event) => {
			const input = event.target as HTMLSelectElement;
			const language = input.value;
			let visible = 0;

			document.querySelectorAll('li[data-listens-languages]').forEach((card) => {
				const languages = JSON.parse(card.getAttribute('data-listens-languages') ?? '[]');

				const matches = language === 'All' || languages.includes(language);

				(card as HTMLLIElement).hidden = !matches;

				if (matches) visible++;
			});

			if (count) count.textContent = String(visible);
			if (label) label.textContent = visible === 1 ? 'song' : 'songs';
		});
	</script>
</Page>
