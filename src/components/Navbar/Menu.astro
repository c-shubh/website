---
import rssIcon from '@/assets/images/Feed-icon.svg';
import ComputerDesktop from '@/components/icons/ComputerDesktop.astro';
import Moon from '@/components/icons/Moon.astro';
import Sun from '@/components/icons/Sun.astro';
import Link from '@/components/Link.astro';
import { BLOG_RSS_FEED } from '@/consts';
import type { SlashPage } from '@/slashPages';
import { Image } from 'astro:assets';

interface Props {
	links: SlashPage[];
}

const { links } = Astro.props;
---

{
	links.map((link) => (
		<li>
			<Link href={link.href}>{link.name}</Link>
		</li>
	))
}
<li>
	<Link href={BLOG_RSS_FEED} title={'RSS Feed'}>
		<Image src={rssIcon} alt="RSS Feed" width={20} />
	</Link>
</li>

<noscript>
	<style>
		.nav-theme-toggle-wrapper {
			display: none;
		}
	</style>
</noscript>

<li class="nav-theme-toggle-wrapper">
	<button title="Toggle theme" type="button" class="nav-theme-toggle">
		<Sun class="size-5 cursor-pointer nav-theme-toggle-light" />
		<Moon class="size-5 cursor-pointer nav-theme-toggle-dark" />
		<ComputerDesktop class="size-5 cursor-pointer nav-theme-toggle-system" />
	</button>
</li>
